#include <stdio.h>
#include <string.h>
int main() {
    char name[100], *word, last[30], result[100] = "", temp[5];

    printf("Enter full name: ");
    gets(name);

    word = strtok(name, " ");
    while(word != NULL) {
        strcpy(last, word);
        word = strtok(NULL, " ");
        if(word != NULL) {
            sprintf(temp, "%c. ", last[0]);
            strcat(result, temp);
        }
    }

    strcat(result, last);
    printf("Abbreviated name: %s", result);
}
