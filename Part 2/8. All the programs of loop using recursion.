#include <stdio.h>

// 1) Print numbers from 1 to n
void print1toN(int n) {
    if (n == 0) return;
    print1toN(n - 1);
    printf("%d ", n);
}

// 2) Print numbers from n to 1
void printNto1(int n) {
    if (n == 0) return;
    printf("%d ", n);
    printNto1(n - 1);
}

// 3) Sum of first n numbers
int sumN(int n) {
    if (n == 0) return 0;
    return n + sumN(n - 1);
}

// 4) Factorial of n
int factorial(int n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}

// 5) Fibonacci series
int fibonacci(int n) {
    if (n <= 1) return n;
    return fibonacci(n - 1) + fibonacci(n - 2);
}

// 6) Print array elements
void printArray(int arr[], int index, int n) {
    if (index == n) return;
    printf("%d ", arr[index]);
    printArray(arr, index + 1, n);
}

// 7) Reverse print array
void printArrayReverse(int arr[], int index, int n) {
    if (index == n) return;
    printArrayReverse(arr, index + 1, n);
    printf("%d ", arr[index]);
}

// 8) Sum of array using recursion
int sumArray(int arr[], int index, int n) {
    if (index == n) return 0;
    return arr[index] + sumArray(arr, index + 1, n);
}

int main() {
    int n;
    int arr[5] = {10, 20, 30, 40, 50};

    printf("Enter a number: ");
    scanf("%d", &n);

    printf("\n1) Print 1 to %d:\n", n);
    print1toN(n);

    printf("\n\n2) Print %d to 1:\n", n);
    printNto1(n);

    printf("\n\n3) Sum of first %d numbers = %d", n, sumN(n));

    printf("\n\n4) Factorial of %d = %d", n, factorial(n));

    printf("\n\n5) Fibonacci series (first %d numbers):\n", n);
    for (int i = 0; i < n; i++) {
        printf("%d ", fibonacci(i));
    }

    printf("\n\n6) Array elements:\n");
    printArray(arr, 0, 5);

    printf("\n\n7) Array in reverse:\n");
    printArrayReverse(arr, 0, 5);

    printf("\n\n8) Sum of array elements = %d\n", sumArray(arr, 0, 5));

    return 0;
}
