#include <stdio.h>

int isLeap(int y) {
    return (y%400==0 || (y%4==0 && y%100!=0));
}

int main() {
    int year;
    printf("Enter a year: ");
    scanf("%d", &year);

    if(isLeap(year))
        printf("%d is a Leap Year", year);
    else
        printf("%d is not a Leap Year", year);

    return 0;
}
